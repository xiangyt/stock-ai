{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "前端: dev",
            "type": "npm",
            "script": "dev",
            "path": "web",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE.*ready in",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "wire: generate",
            "type": "shell",
            "command": "go",
            "args": ["generate", "./cmd/server/"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "前端: build",
            "type": "npm",
            "script": "build",
            "path": "web",
            "group": "build"
        }
    ]
}
